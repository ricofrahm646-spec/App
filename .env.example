# ─────────────────────────────────────────────────────────────────────
# Hardcore Growth Mode – Crypto Trading Bot  |  Environment Configuration
# Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────────────────

# ── Exchange ──────────────────────────────────────────────────────────
# Any exchange supported by ccxt (e.g. kraken, bitvavo, binance, coinbase)
EXCHANGE_ID=kraken
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# ── Quote currency ────────────────────────────────────────────────────
QUOTE_CURRENCY=EUR

# ── Scanning interval (seconds) ──────────────────────────────────────
SCAN_INTERVAL_MIN=20
SCAN_INTERVAL_MAX=30

# ── Scoring thresholds ────────────────────────────────────────────────
RSI_THRESHOLD=40          # RSI below this value earns 25 pts
MACD_POSITIVE=true        # MACD diff > 0 earns 25 pts
VOLUME_SPIKE_RATIO=1.5    # Current vol / avg vol >= 1.5 earns 25 pts
PRICE_INCREASE_THRESHOLD=0.02   # +2% in last 5 candles earns 25 pts
MIN_SCORE=80              # Only trade coins scoring >= this
MAX_TOP_COINS=3           # Trade at most this many coins per cycle

# ── Trade sizing (% of free EUR balance) ──────────────────────────────
TRADE_AMOUNT_PERCENT_MIN=0.30   # 30%
TRADE_AMOUNT_PERCENT_MAX=0.50   # 50%

# ── Risk management ───────────────────────────────────────────────────
STOP_LOSS_PERCENT=0.025         # 2.5%
TAKE_PROFIT_PERCENT=0.075       # 7.5%

# ── Retry configuration ───────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY=5                   # seconds between retries

# ── Telegram alerts (leave blank to disable) ──────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Data / logging ────────────────────────────────────────────────────
DATA_DIR=data

# ── OHLCV candle settings ─────────────────────────────────────────────
CANDLE_TIMEFRAME=1m
CANDLE_LIMIT=100
