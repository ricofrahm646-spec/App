# ── JARVIS environment ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=JARVIS
APP_PORT=8000
FRONTEND_PORT=3000
SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=                          # base64 32-byte Fernet key (auto-generated on first run if empty)

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MetaTrader 5 ────────────────────────────────────────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                                # full path to terminal64.exe
MT5_MOCK=true                            # use the mock connector when MT5 is unavailable
MT5_DATA_PATH=                           # e.g. C:\Users\<you>\AppData\Roaming\MetaQuotes\Terminal\<id>\MQL5

# ── LLM ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai                      # openai | anthropic | local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Telegram ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── TradingView ─────────────────────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=change-me

# ── Risk ────────────────────────────────────────────────────────────
RISK_MAX_OPEN_TRADES=1
RISK_MAX_LOSS_PCT=20.0                   # close trade at -20%
RISK_RISK_PER_TRADE_PCT=1.0              # 1% account risk per trade
RISK_ALLOW_OPPOSITE_SIDES=false

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
