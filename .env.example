# ═══════════════════════════════════════════════════════════════
# JARVIS AI Trading OS – Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
APP_NAME=JARVIS
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret_change_me
POSTGRES_DB=jarvis_db
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_secret_change_me@localhost:5432/jarvis_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret_change_me
REDIS_URL=redis://:redis_secret_change_me@localhost:6379/0
CELERY_BROKER_URL=redis://:redis_secret_change_me@localhost:6379/1

# ── MetaTrader 5 ──────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:/Program Files/MetaTrader 5

# ── AI / OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
AI_MODEL=gpt-4o

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-100123456789

# ── TradingView ───────────────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=your-webhook-secret

# ── Risk Management ───────────────────────────────────────────
MAX_TRADES=1
MAX_DRAWDOWN_PERCENT=20.0
MAX_RISK_PER_TRADE=2.0

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# ── Encryption ────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here
