APP_NAME=JARVIS Trading Operating System
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0
ENCRYPTION_KEY=replace-with-a-strong-fernet-key

LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
MAX_OPEN_TRADES=1
FORCED_CLOSE_LOSS_PERCENT=20

MT5_TERMINAL_PATH=
MT5_DATA_PATH=/root/.jarvis/mt5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRADINGVIEW_WEBHOOK_SECRET=replace-me
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
