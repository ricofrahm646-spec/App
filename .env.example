# JARVIS Trading OS Configuration

# Database
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_secret@localhost:5432/jarvis
DATABASE_SYNC_URL=postgresql://jarvis:jarvis_secret@localhost:5432/jarvis

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# MetaTrader 5
MT5_PATH=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_DATA_PATH=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TradingView
TRADINGVIEW_WEBHOOK_SECRET=

# AI
AI_MODEL_PATH=./ai/models/saved
OPENAI_API_KEY=

# Risk Management
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.20
MAX_CONCURRENT_TRADES=1
EMERGENCY_STOP_LOSS_PCT=0.20
