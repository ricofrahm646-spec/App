#property copyright "JARVIS"
#property version   "1.00"
#property strict
#property description "{{ description }}"

#include <Trade/Trade.mqh>

CTrade trade;

// ─── User inputs ──────────────────────────────────────────────────
input string  Symbol_      = "{{ symbol }}";
input ENUM_TIMEFRAMES TF   = {{ timeframe_const }};
input double  Lots         = {{ parameters.lots | default(0.10) }};
input double  RiskPct      = {{ parameters.risk_pct | default(1.0) }};
input int     SL_Pips      = {{ parameters.sl_pips | default(40) }};
input int     TP_Pips      = {{ parameters.tp_pips | default(80) }};
input int     MagicNumber  = {{ parameters.magic | default(880001) }};
input bool    UseTrailing  = {{ parameters.use_trailing | default('true') | lower }};
input int     TrailStartPips = {{ parameters.trail_start | default(20) }};
input int     TrailStepPips  = {{ parameters.trail_step | default(10) }};

// Strategy parameters
{% for key, value in strategy_inputs.items() -%}
input double Param_{{ key }} = {{ value }};
{% endfor %}

// ─── Helpers ──────────────────────────────────────────────────────
double Pip() { return _Point * 10.0; }

double Ema(int handle, int shift = 0) {
   double buf[];
   if(CopyBuffer(handle, 0, shift, 1, buf) <= 0) return 0.0;
   return buf[0];
}

bool HasOpenPosition() {
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(PositionGetString(POSITION_SYMBOL) == Symbol_ &&
         PositionGetInteger(POSITION_MAGIC) == MagicNumber) return true;
   }
   return false;
}

void TrailingStop() {
   if(!UseTrailing) return;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(PositionGetString(POSITION_SYMBOL) != Symbol_) continue;
      if(PositionGetInteger(POSITION_MAGIC) != MagicNumber) continue;

      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl   = PositionGetDouble(POSITION_SL);
      double tp   = PositionGetDouble(POSITION_TP);
      double bid  = SymbolInfoDouble(Symbol_, SYMBOL_BID);
      double ask  = SymbolInfoDouble(Symbol_, SYMBOL_ASK);
      long type   = PositionGetInteger(POSITION_TYPE);

      double pip = Pip();
      double trailStart = TrailStartPips * pip;
      double trailStep  = TrailStepPips  * pip;

      if(type == POSITION_TYPE_BUY) {
         if(bid - open >= trailStart) {
            double newSl = bid - trailStep;
            if(newSl > sl) trade.PositionModify(ticket, newSl, tp);
         }
      } else if(type == POSITION_TYPE_SELL) {
         if(open - ask >= trailStart) {
            double newSl = ask + trailStep;
            if(newSl < sl || sl == 0.0) trade.PositionModify(ticket, newSl, tp);
         }
      }
   }
}

int OnInit() {
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFillingBySymbol(Symbol_);
   PrintFormat("JARVIS EA '{{ name }}' initialised on %s %s", Symbol_, EnumToString(TF));
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason) {
   PrintFormat("JARVIS EA '{{ name }}' stopped (reason=%d)", reason);
}

void OnTick() {
   TrailingStop();

   if(HasOpenPosition()) return;

   // ── Strategy logic ({{ strategy_kind }}) ────────────────────────
   {{ strategy_logic | indent(3) }}
}

