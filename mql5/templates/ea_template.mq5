#property copyright "JARVIS AI Trading OS"
#property link      ""
#property version   "1.00"
#property strict

//--- Input parameters
input int      MagicNumber       = {{ magic_number }};
input double   DefaultLotSize    = {{ default_lot }};
input double   DefaultSL         = {{ default_sl }};         // Stop Loss in points
input double   DefaultTP         = {{ default_tp }};         // Take Profit in points
input double   RiskPercent       = {{ risk_percent }};       // Risk per trade (%)
input bool     UseFixedLot       = {{ use_fixed_lot }};
input int      MaxSlippage       = {{ max_slippage }};       // Maximum slippage in points
input int      MaxConcurrentTrades = 1;                      // Max concurrent trades
input double   EmergencyStopPct  = 20.0;                     // Emergency stop loss (% of balance)

//--- Trailing stop inputs
input bool     UseTrailingStop    = {{ use_trailing_stop }};
input double   TrailingActivation = {{ trailing_activation }}; // Pips profit to activate
input double   TrailingDistance   = {{ trailing_distance }};   // Trail distance in pips
input double   TrailingStep      = {{ trailing_step }};        // Minimum step in pips

{% if extra_inputs %}
//--- Strategy-specific inputs
{{ extra_inputs }}
{% endif %}

//--- Global variables
int            g_ticket = -1;
datetime       g_lastTradeTime = 0;
double         g_peakEquity = 0;
bool           g_dailyLimitHit = false;
datetime       g_lastDay = 0;
double         g_dailyStartBalance = 0;

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\SymbolInfo.mqh>

CTrade         g_trade;
CPositionInfo  g_posInfo;
CSymbolInfo    g_symInfo;

{% if custom_includes %}
{{ custom_includes }}
{% endif %}

//+------------------------------------------------------------------+
//| Expert initialization function                                     |
//+------------------------------------------------------------------+
int OnInit()
{
   g_trade.SetExpertMagicNumber(MagicNumber);
   g_trade.SetDeviationInPoints(MaxSlippage);
   g_trade.SetTypeFilling(ORDER_FILLING_IOC);

   g_symInfo.Name(_Symbol);
   g_symInfo.Refresh();

   g_peakEquity = AccountInfoDouble(ACCOUNT_EQUITY);
   g_dailyStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   g_lastDay = iTime(_Symbol, PERIOD_D1, 0);

   Print("{{ ea_name }} initialized on ", _Symbol,
         " | Magic=", MagicNumber,
         " | Lot=", DefaultLotSize,
         " | SL=", DefaultSL,
         " | TP=", DefaultTP);

{% if on_init_extra %}
   {{ on_init_extra }}
{% endif %}

   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                                   |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
{% if on_deinit_extra %}
   {{ on_deinit_extra }}
{% endif %}
   Print("{{ ea_name }} deinitialized. Reason: ", reason);
}

//+------------------------------------------------------------------+
//| Expert tick function                                               |
//+------------------------------------------------------------------+
void OnTick()
{
   //--- Refresh symbol data
   g_symInfo.Refresh();

   //--- Reset daily limits on new day
   datetime currentDay = iTime(_Symbol, PERIOD_D1, 0);
   if(currentDay != g_lastDay)
   {
      g_lastDay = currentDay;
      g_dailyLimitHit = false;
      g_dailyStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   }

   //--- Check emergency stop on open positions
   CheckEmergencyStop();

   //--- Apply trailing stop
   if(UseTrailingStop)
      ApplyTrailingStop();

   //--- Update peak equity for drawdown tracking
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   if(equity > g_peakEquity)
      g_peakEquity = equity;

   //--- Skip if daily loss limit hit
   if(g_dailyLimitHit)
      return;

{% if strategy_logic %}
   //--- Strategy logic
   {{ strategy_logic }}
{% endif %}

   //--- Count open positions for this EA
   int openCount = CountOpenPositions();

   //--- Enforce max concurrent trades
   if(openCount >= MaxConcurrentTrades)
      return;

   //--- Check entry conditions
   bool buySignal  = CheckBuyCondition();
   bool sellSignal = CheckSellCondition();

   //--- Never open buy and sell simultaneously
   if(buySignal && sellSignal)
   {
      buySignal = false;
      sellSignal = false;
   }

   //--- Prevent opening opposite direction to existing trade
   if(openCount > 0)
   {
      if(buySignal && HasSellPosition())
         buySignal = false;
      if(sellSignal && HasBuyPosition())
         sellSignal = false;
   }

   //--- Execute trades
   if(buySignal)
      OpenBuy();
   if(sellSignal)
      OpenSell();
}

