//+------------------------------------------------------------------+
//| Open a BUY position                                               |
//+------------------------------------------------------------------+
void OpenBuy()
{
   double ask = g_symInfo.Ask();
   double sl  = (DefaultSL > 0) ? NormalizeDouble(ask - DefaultSL * _Point, _Digits) : 0;
   double tp  = (DefaultTP > 0) ? NormalizeDouble(ask + DefaultTP * _Point, _Digits) : 0;
   double lot = CalculateLotSize();

   if(g_trade.Buy(lot, _Symbol, ask, sl, tp, "{{ ea_name }}"))
   {
      g_ticket = (int)g_trade.ResultOrder();
      g_lastTradeTime = TimeCurrent();
      Print("BUY opened: ticket=", g_ticket, " price=", ask, " lot=", lot, " sl=", sl, " tp=", tp);
   }
   else
   {
      Print("BUY failed: ", g_trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
//| Open a SELL position                                              |
//+------------------------------------------------------------------+
void OpenSell()
{
   double bid = g_symInfo.Bid();
   double sl  = (DefaultSL > 0) ? NormalizeDouble(bid + DefaultSL * _Point, _Digits) : 0;
   double tp  = (DefaultTP > 0) ? NormalizeDouble(bid - DefaultTP * _Point, _Digits) : 0;
   double lot = CalculateLotSize();

   if(g_trade.Sell(lot, _Symbol, bid, sl, tp, "{{ ea_name }}"))
   {
      g_ticket = (int)g_trade.ResultOrder();
      g_lastTradeTime = TimeCurrent();
      Print("SELL opened: ticket=", g_ticket, " price=", bid, " lot=", lot, " sl=", sl, " tp=", tp);
   }
   else
   {
      Print("SELL failed: ", g_trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
//| Calculate lot size based on risk                                  |
//+------------------------------------------------------------------+
double CalculateLotSize()
{
   if(UseFixedLot)
      return DefaultLotSize;

   double balance   = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskMoney = balance * RiskPercent / 100.0;

   if(DefaultSL <= 0)
      return DefaultLotSize;

   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);

   if(tickValue <= 0 || tickSize <= 0)
      return DefaultLotSize;

   double slMoney  = DefaultSL * _Point * tickValue / tickSize;
   double lot      = (slMoney > 0) ? riskMoney / slMoney : DefaultLotSize;

   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   lot = MathMax(minLot, MathMin(lot, maxLot));
   if(stepLot > 0)
      lot = MathFloor(lot / stepLot) * stepLot;

   return NormalizeDouble(lot, 2);
}

//+------------------------------------------------------------------+
//| Count open positions for this EA                                  |
//+------------------------------------------------------------------+
int CountOpenPositions()
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(g_posInfo.SelectByIndex(i))
      {
         if(g_posInfo.Magic() == MagicNumber && g_posInfo.Symbol() == _Symbol)
            count++;
      }
   }
   return count;
}

//+------------------------------------------------------------------+
//| Check if a BUY position exists                                    |
//+------------------------------------------------------------------+
bool HasBuyPosition()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(g_posInfo.SelectByIndex(i))
      {
         if(g_posInfo.Magic() == MagicNumber && g_posInfo.Symbol() == _Symbol
            && g_posInfo.PositionType() == POSITION_TYPE_BUY)
            return true;
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| Check if a SELL position exists                                   |
//+------------------------------------------------------------------+
bool HasSellPosition()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(g_posInfo.SelectByIndex(i))
      {
         if(g_posInfo.Magic() == MagicNumber && g_posInfo.Symbol() == _Symbol
            && g_posInfo.PositionType() == POSITION_TYPE_SELL)
            return true;
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| Emergency stop: close if loss >= threshold % of balance           |
//+------------------------------------------------------------------+
void CheckEmergencyStop()
{
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   if(balance <= 0)
      return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!g_posInfo.SelectByIndex(i))
         continue;
      if(g_posInfo.Magic() != MagicNumber || g_posInfo.Symbol() != _Symbol)
         continue;

      double profit = g_posInfo.Profit() + g_posInfo.Swap() + g_posInfo.Commission();
      double lossPct = MathAbs(profit) / balance * 100.0;

      if(profit < 0 && lossPct >= EmergencyStopPct)
      {
         Print("EMERGENCY STOP: ticket=", g_posInfo.Ticket(),
               " loss=", profit, " (", NormalizeDouble(lossPct, 1), "% of balance)");
         g_trade.PositionClose(g_posInfo.Ticket());
      }
   }

   //--- Daily loss limit (5 % of starting balance)
   double dayPnL = AccountInfoDouble(ACCOUNT_BALANCE) - g_dailyStartBalance;
   double unrealized = AccountInfoDouble(ACCOUNT_EQUITY) - AccountInfoDouble(ACCOUNT_BALANCE);
   double totalDayPnL = dayPnL + unrealized;
   if(totalDayPnL < 0 && MathAbs(totalDayPnL) / g_dailyStartBalance * 100.0 >= 5.0)
   {
      if(!g_dailyLimitHit)
      {
         Print("DAILY LOSS LIMIT HIT. Closing all positions.");
         g_dailyLimitHit = true;
         CloseAllPositions();
      }
   }
}

//+------------------------------------------------------------------+
//| Close all positions for this EA                                   |
//+------------------------------------------------------------------+
void CloseAllPositions()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(g_posInfo.SelectByIndex(i))
      {
         if(g_posInfo.Magic() == MagicNumber && g_posInfo.Symbol() == _Symbol)
            g_trade.PositionClose(g_posInfo.Ticket());
      }
   }
}

//+------------------------------------------------------------------+
//| Trailing stop logic                                               |
//+------------------------------------------------------------------+
void ApplyTrailingStop()
{
   double point = _Point;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!g_posInfo.SelectByIndex(i))
         continue;
      if(g_posInfo.Magic() != MagicNumber || g_posInfo.Symbol() != _Symbol)
         continue;

      double openPrice   = g_posInfo.PriceOpen();
      double currentSL   = g_posInfo.StopLoss();
      double currentTP   = g_posInfo.TakeProfit();
      ulong  ticket      = g_posInfo.Ticket();

      if(g_posInfo.PositionType() == POSITION_TYPE_BUY)
      {
         double bid = g_symInfo.Bid();
         double profitPips = (bid - openPrice) / point;

         if(profitPips >= TrailingActivation)
         {
            double newSL = NormalizeDouble(bid - TrailingDistance * point, _Digits);

            if(newSL > currentSL + TrailingStep * point || currentSL == 0)
            {
               if(g_trade.PositionModify(ticket, newSL, currentTP))
                  Print("Trailing BUY: ticket=", ticket, " newSL=", newSL);
            }
         }
      }
      else if(g_posInfo.PositionType() == POSITION_TYPE_SELL)
      {
         double ask = g_symInfo.Ask();
         double profitPips = (openPrice - ask) / point;

         if(profitPips >= TrailingActivation)
         {
            double newSL = NormalizeDouble(ask + TrailingDistance * point, _Digits);

            if((newSL < currentSL - TrailingStep * point) || currentSL == 0)
            {
               if(g_trade.PositionModify(ticket, newSL, currentTP))
                  Print("Trailing SELL: ticket=", ticket, " newSL=", newSL);
            }
         }
      }
   }
}

