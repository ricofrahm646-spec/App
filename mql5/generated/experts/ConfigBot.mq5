//+------------------------------------------------------------------+
//| ConfigBot.mq5                                                        |
//| JARVIS AI Trading System                                          |
//| Generated by JARVIS MQL5 Generator                               |
//+------------------------------------------------------------------+
#property copyright "JARVIS AI"
#property version   "1.00"
#property strict

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\AccountInfo.mqh>

// === Trading Settings ===
input group "=== Trading Settings ==="
input double   InpRiskPercent      = 2.0;
input int      InpMagicNumber      = 77777;
input string   InpComment          = "JARVIS_SCALPING";

input group "=== Stop Loss / Take Profit ==="
input int      InpStopLoss         = 30;
input int      InpTakeProfit       = 60;
input bool     InpUseTrailingStop  = true;
input int      InpTrailingStart    = 20;
input int      InpTrailingStep     = 5;

input group "=== Indicator Settings ==="
input int      InpRSIPeriod        = 14;
input int      InpStochK           = 5;
input int      InpStochD           = 3;
input int      InpEMAFast          = 20;
input int      InpEMASlow          = 50;

// Global variables
CTrade         Trade;
CPositionInfo  PositionInfo;
CAccountInfo   AccountInfo;

int  handleRSI;
int  handleStoch;
int  handleEMAFast;
int  handleEMASlow;
bool isNewBar      = false;
datetime lastBar   = 0;

//+------------------------------------------------------------------+
int OnInit()
{
   Trade.SetExpertMagicNumber(InpMagicNumber);
   Trade.SetDeviationInPoints(10);
   Trade.SetTypeFilling(ORDER_FILLING_FOK);

   handleRSI     = iRSI(_Symbol, PERIOD_M15, InpRSIPeriod, PRICE_CLOSE);
   handleStoch   = iStochastic(_Symbol, PERIOD_M15, InpStochK, InpStochD, 3, MODE_SMA, STO_LOWHIGH);
   handleEMAFast = iMA(_Symbol, PERIOD_M15, InpEMAFast, 0, MODE_EMA, PRICE_CLOSE);
   handleEMASlow = iMA(_Symbol, PERIOD_M15, InpEMASlow, 0, MODE_EMA, PRICE_CLOSE);

   if(handleRSI == INVALID_HANDLE || handleStoch == INVALID_HANDLE ||
      handleEMAFast == INVALID_HANDLE || handleEMASlow == INVALID_HANDLE)
   {
      Print("Error creating indicator handles: ", GetLastError());
      return INIT_FAILED;
   }

   Print("ConfigBot initialised on ", _Symbol, " / M15");
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(handleRSI);
   IndicatorRelease(handleStoch);
   IndicatorRelease(handleEMAFast);
   IndicatorRelease(handleEMASlow);
}

//+------------------------------------------------------------------+
void OnTick()
{
   if(!IsNewBar()) return;
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return;

   double rsiBuffer[3], stochMain[3], stochSignal[3], emaFast[3], emaSlow[3];

   if(CopyBuffer(handleRSI,     0, 1, 3, rsiBuffer)  < 3) return;
   if(CopyBuffer(handleStoch,   0, 1, 3, stochMain)  < 3) return;
   if(CopyBuffer(handleStoch,   1, 1, 3, stochSignal)< 3) return;
   if(CopyBuffer(handleEMAFast, 0, 1, 3, emaFast)    < 3) return;
   if(CopyBuffer(handleEMASlow, 0, 1, 3, emaSlow)    < 3) return;

   double rsiValue    = rsiBuffer[0];
   double stochValue  = stochMain[0];
   double emaFastVal  = emaFast[0];
   double emaSlowVal  = emaSlow[0];

   ManageOpenPositions();

   int posCount = CountPositions();
   if(posCount > 0) return;

   // Buy condition: rsiValue < 30 && stochMain < 20
   bool buySignal  = (rsiValue < 30 && stochMain < 20);
   // Sell condition: rsiValue > 70 && stochMain > 80
   bool sellSignal = (rsiValue > 70 && stochMain > 80);

   if(buySignal)  OpenBuy();
   if(sellSignal) OpenSell();
}

//+------------------------------------------------------------------+
void OpenBuy()
{
   double ask     = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double sl      = ask - InpStopLoss * _Point * 10;
   double tp      = ask + InpTakeProfit * _Point * 10;
   double lots    = CalculateLotSize(InpStopLoss * _Point * 10);

   if(lots <= 0) return;

   if(!Trade.Buy(lots, _Symbol, ask, sl, tp, InpComment))
      Print("Buy failed: ", Trade.ResultRetcodeDescription());
}

//+------------------------------------------------------------------+
void OpenSell()
{
   double bid  = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double sl   = bid + InpStopLoss * _Point * 10;
   double tp   = bid - InpTakeProfit * _Point * 10;
   double lots = CalculateLotSize(InpStopLoss * _Point * 10);

   if(lots <= 0) return;

   if(!Trade.Sell(lots, _Symbol, bid, sl, tp, InpComment))
      Print("Sell failed: ", Trade.ResultRetcodeDescription());
}

//+------------------------------------------------------------------+
void ManageOpenPositions()
{
   if(!InpUseTrailingStop) return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!PositionInfo.SelectByIndex(i)) continue;
      if(PositionInfo.Symbol() != _Symbol) continue;
      if(PositionInfo.Magic()  != InpMagicNumber) continue;

      ApplyTrailingStop(PositionInfo.Ticket(), PositionInfo.PositionType(),
                        PositionInfo.PriceOpen(), PositionInfo.StopLoss());
   }
}

//+------------------------------------------------------------------+
void ApplyTrailingStop(ulong ticket, ENUM_POSITION_TYPE type,
                       double openPrice, double currentSL)
{
   double ask  = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid  = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double step = InpTrailingStep  * _Point * 10;
   double start= InpTrailingStart * _Point * 10;

   double newSL = 0;

   if(type == POSITION_TYPE_BUY)
   {
      if(bid - openPrice < start) return;
      newSL = bid - InpTrailingStep * _Point * 10;
      if(newSL <= currentSL + step) return;
   }
   else
   {
      if(openPrice - ask < start) return;
      newSL = ask + InpTrailingStep * _Point * 10;
      if(newSL >= currentSL - step || currentSL == 0) return;
   }

   Trade.PositionModify(ticket, newSL, PositionInfo.TakeProfit());
}

//+------------------------------------------------------------------+
double CalculateLotSize(double slDistance)
{
   double balance    = AccountInfo.Balance();
   double riskAmount = balance * InpRiskPercent / 100.0;
   double tickValue  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize   = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);

   if(tickSize == 0 || tickValue == 0 || slDistance == 0) return 0;

   double lots = riskAmount / (slDistance / tickSize * tickValue);
   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   lots = MathFloor(lots / lotStep) * lotStep;
   lots = MathMax(minLot, MathMin(maxLot, lots));
   return lots;
}

//+------------------------------------------------------------------+
int CountPositions()
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(PositionInfo.SelectByIndex(i) &&
         PositionInfo.Symbol() == _Symbol &&
         PositionInfo.Magic()  == InpMagicNumber)
         count++;
   }
   return count;
}

//+------------------------------------------------------------------+
bool IsNewBar()
{
   datetime currentBar = iTime(_Symbol, PERIOD_M15, 0);
   if(currentBar == lastBar) return false;
   lastBar = currentBar;
   return true;
}
