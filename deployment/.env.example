# ═══════════════════════════════════════════════════════════════════════════
# JARVIS AI Trading Operating System — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="JARVIS Trading OS"
APP_VERSION=1.0.0
ENVIRONMENT=production          # development | staging | production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ── Security ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret_change_me
POSTGRES_DB=jarvis
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_secret_change_me@postgres:5432/jarvis

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_PORT=6379

# ── MetaTrader 5 ─────────────────────────────────────────────────────────
MT5_HOST=localhost
MT5_PORT=8001
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_ACCOUNT=0
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT=30000
MT5_RECONNECT_INTERVAL=5

# ── Telegram Bot ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_TRADE_ALERTS=true
TELEGRAM_ERROR_ALERTS=true
TELEGRAM_DAILY_SUMMARY=true

# ── TradingView ──────────────────────────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_ALLOWED_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
TRADINGVIEW_AUTO_EXECUTE=false

# ── AI / LLM ────────────────────────────────────────────────────────────
AI_PROVIDER=openai               # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_CHAT_HISTORY_LIMIT=100
AI_MODEL_PATH=./models

# ── Risk Management ─────────────────────────────────────────────────────
RISK_MAX_RISK_PERCENT=2.0
RISK_MAX_DAILY_LOSS_PERCENT=5.0
RISK_MAX_DRAWDOWN=20.0
RISK_MAX_OPEN_TRADES=1
RISK_MIN_RISK_REWARD=1.0

# ── Backtesting ──────────────────────────────────────────────────────────
BACKTEST_DEFAULT_CAPITAL=10000
BACKTEST_DEFAULT_COMMISSION=0.0002
BACKTEST_MAX_CONCURRENT=4
BACKTEST_DATA_DIR=./data/historical

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_JSON_FORMAT=true

# ── Docker Ports (host mapping) ─────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
